  "denials": [
    "short AES-GCM payload",
    "wrong AES-GCM key size",
    "unknown crypt-filter CFM",
    "PubSec missing provider",
    "PubSec wrong private key",
    "PubSec duplicate recipient certificate",
    "unsupported CMS recipient type",
    "unsupported PubSec crypt-filter CFM",
    "PDF-MAC AuthCode without Encrypt dictionary",
    "PDF-MAC malformed ByteRange",
    "PDF-MAC malformed CMS AuthenticatedData",
    "PDF-MAC unsupported MACLocation"
  ]
