{
  "schema": "prompt23b.limit-denial-results.v1",
  "status": "implemented_with_limits",
  "limits": {
    "aesgcm_min_payload_bytes": 28,
    "aesgcm_key_bytes": 32,
    "aesgcm_iv_bytes": 12,
    "aesgcm_tag_bytes": 16,
    "aesgcm_nonce_collision_attempts": 16,
    "pubsec_cms_bytes": 1048576,
    "pubsec_recipient_count": 64,
    "pubsec_provider_identity_count": 64,
    "pdf_mac_kdf_salt_bytes": 32,
    "pdf_mac_byte_range_entries": 4
