  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "exactOptionalPropertyTypes": true,
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["wellfriendpdf.d.ts", "browser/**/*.d.ts"],
  "exclude": ["pkg", "pkg-node", "node_modules"]
