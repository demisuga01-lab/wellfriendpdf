{
  "name": "@oxidepdf/oxide-wasm",
  "version": "0.1.0",
  "description": "Browser, Node, and WebWorker WASM binding for the Oxide PDF SDK.",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/oxide-pdf/oxide"
  },
  "files": [
    "pkg",
    "oxide.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./oxide.d.ts",
      "default": "./pkg/oxide_wasm.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build:web": "wasm-pack build . --target web --out-dir pkg",
    "build:node": "wasm-pack build . --target nodejs --out-dir pkg-node",
    "typecheck": "tsc --noEmit --allowJs false"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "wasm-pack": "^0.13.0"
  }
}
